				{
					"listen": "test",
					"script": {
						"id": "1a2b3c4d-0005-4000-8000-000000000005",
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "DELETE",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/v1/Authors/{{authorId}}",
					"host": ["{{baseUrl}}"],
					"path": ["api", "v1", "Authors", "{{authorId}}"]
				}
			},
			"response": []
		}
	],
	"variable": [
		{ "key": "baseUrl", "value": "https://fakerestapi.azurewebsites.net" },
		{ "key": "firstName", "value": "Ethar" },
		{ "key": "lastName", "value": "Alrehaili" },
