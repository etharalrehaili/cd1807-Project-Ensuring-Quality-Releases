**/*.tfstate
**/*.json
**/*.exe
# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log

# Ignore any .tfvars files that are generated automatically for each Terraform run. Most
# .tfvars files are managed as part of configuration and so should be included in
# version control.
#
# example.tfvars

# Ignore override files as they are usually used to override resources locally and so
# are not checked in
override.tf
override.tf.json
*_override.tf
*_override.tf.jsonterraform/environments/test/terraform.tfvars

terraform/environments/test/terraform.tfvars
tfplan

# Explicitly track these Postman test suite collections despite the *.json ignore rule above
!automatedtesting/postman/RegressionTestSuite.json
!automatedtesting/postman/DataValidationTestSuite.json
